<Window x:Class="Presentationslager.Bokning"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skapa bokning"
        Height="800"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource IsBlå}" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Rubrik -->
        <TextBlock Grid.Row="0"
                   Text="Skapa bokning"
                   Style="{StaticResource HeaderTextStyle}"
                   Margin="0,0,0,20"/>

        <!-- Kund och datum -->
        <Grid Grid.Row="1" Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Kund:"
                       VerticalAlignment="Center"
                       Margin="5"/>

            <ComboBox x:Name="cmbKund"
                      Grid.Column="1"
                      Height="30"
                      Margin="5"
                      DisplayMemberPath="DisplayText"
                      SelectionChanged="cmbKund_SelectionChanged" />    

            <TextBlock Grid.Column="3"
                       Text="Från:"
                       VerticalAlignment="Center"
                       Margin="5"/>

            <DatePicker x:Name="dpStartDatum"
                        Grid.Column="4"
                        Height="30"
                        Margin="5"
                        SelectedDateChanged="Datum_Changed" />

            <TextBlock Grid.Column="6"
                       Text="Till:"
                       VerticalAlignment="Center"
                       Margin="5"/>

            <DatePicker x:Name="dpSlutDatum"
                        Grid.Column="7"
                        Height="30"
                        Margin="5"
                        SelectedDateChanged="Datum_Changed" />

        </Grid>

        <!-- Scrollbar med alla bokningsdelar -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- BOENDE -->
                <Border Background="White"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Boende"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <!-- Här visas valda boenden senare -->
                        <StackPanel Margin="0,0,0,10">

                            <ItemsControl x:Name="lstLogiRader"
                                            Margin="0,0,0,10">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Border BorderBrush="LightGray"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10"
                                                Margin="0,0,0,5">

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>

                                                    <TextBlock Text="{Binding logi.DisplayText}"
                                                                 FontWeight="Bold"/>

                                                    <TextBlock>
                                                    <Run Text="Antal personer: "/>
                                                    <Run Text="{Binding AntalPersoner}"/>       
                                                    </TextBlock>

                                                    <TextBlock>
                                                    <Run Text="Period: "/>
                                                    <Run Text="{Binding StartDatum, StringFormat={}{0:yyyy-MM-dd}}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding SlutDatum, StringFormat={}{0:yyyy-MM-dd}}"/>
                                                    </TextBlock>

                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                       Text="{Binding LogiBelopp, StringFormat={}{0:N0} kr}"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="20,0,0,0"/>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                        <Expander Header="+ Lägg till boende">

                            <StackPanel Margin="10">

                                <TextBlock Text="Antal personer:"/>

                                <ComboBox x:Name="cmbAntalPersonerTotalt"
                                           Height="30"
                                           Margin="0,5,0,10"
                                           SelectionChanged="cmbAntalPersonerTotalt_SelectionChanged" />

                                <TextBlock x:Name="txtBoendePlacering"
                                           Text="0 av 0 personer placerade"
                                           Margin="0,0,0,10"
                                           FontWeight="SemiBold"/>
                                
                                <TextBlock Text="Boende:"/>

                                <ComboBox x:Name="cmbLogi"
                                          Height="30"
                                          Margin="0,5,0,10"
                                          DisplayMemberPath="DisplayText"
                                          SelectionChanged="cmbLogi_SelectionChanged" />

                                <TextBlock Text="Antal personer i detta boende:"/>

                                <ComboBox x:Name="cmbAntalPersonerValtLogi"
                                              Height="30"
                                              Margin="0,5,0,10"/>
                                
                                <TextBlock x:Name="txtLogiPris"
                                           Text="0 kr"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>

                                <Button Content="Lägg till"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        Click="LäggTillLogi_Click"/>

                            </StackPanel>

                        </Expander>

                    </StackPanel>

                </Border>


                <!-- UTRUSTNING -->
                <Border Background="White"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Utrustning"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,10">

                            <TextBlock Text="Ingen utrustning vald ännu."
                                       FontStyle="Italic"/>

                        </StackPanel>

                        <Expander Header="+ Lägg till utrustning">

                            <StackPanel Margin="10">

                                <TextBlock Text="Utrustning:"/>

                                <ComboBox Height="30"
                                          Margin="0,5,0,10"/>

                                <TextBlock Text="Antal:"/>

                                <TextBox Height="30"
                                         Margin="0,5,0,10"/>

                                <TextBlock Text="Pris:"
                                           Margin="0,0,0,5"/>

                                <TextBlock Text="0 kr"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>

                                <Button Content="Lägg till"
                                        Width="120"
                                        HorizontalAlignment="Left"/>

                            </StackPanel>

                        </Expander>

                    </StackPanel>

                </Border>


                <!-- KONFERENS -->
                <Border Background="White"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Konferens"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,10">

                            <TextBlock Text="Ingen konferens vald ännu."
                                       FontStyle="Italic"/>

                        </StackPanel>

                        <Expander Header="+ Lägg till konferens">

                            <StackPanel Margin="10">

                                <TextBlock Text="Konferenslokal:"/>

                                <ComboBox Height="30"
                                          Margin="0,5,0,10"/>

                                <TextBlock Text="Antal personer:"/>

                                <TextBox Height="30"
                                         Margin="0,5,0,10"/>

                                <TextBlock Text="Starttid:"/>

                                <DatePicker Height="30"
                                            Margin="0,5,0,10"/>

                                <TextBlock Text="Sluttid:"/>

                                <DatePicker Height="30"
                                            Margin="0,5,0,10"/>

                                <TextBlock Text="Pris:"
                                           Margin="0,0,0,5"/>

                                <TextBlock Text="0 kr"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>

                                <Button Content="Lägg till"
                                        Width="120"
                                        HorizontalAlignment="Left"/>

                            </StackPanel>

                        </Expander>

                    </StackPanel>

                </Border>


                <!-- SKIDLEKTION -->
                <Border Background="White"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Skidlektion"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,10">

                            <TextBlock Text="Ingen skidlektion vald ännu."
                                       FontStyle="Italic"/>

                        </StackPanel>

                        <Expander Header="+ Lägg till skidlektion">

                            <StackPanel Margin="10">

                                <TextBlock Text="Skidlektion:"/>

                                <ComboBox Height="30"
                                          Margin="0,5,0,10"/>

                                <TextBlock Text="Antal personer:"/>

                                <TextBox Height="30"
                                         Margin="0,5,0,10"/>

                                <TextBlock Text="Datum:"/>

                                <DatePicker Height="30"
                                            Margin="0,5,0,10"/>

                                <TextBlock Text="Pris:"
                                           Margin="0,0,0,5"/>

                                <TextBlock Text="0 kr"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>

                                <Button Content="Lägg till"
                                        Width="120"
                                        HorizontalAlignment="Left"/>

                            </StackPanel>

                        </Expander>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- Total och knappar -->
        <Grid Grid.Row="3"
              Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="Totalt:"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,10,0"/>

                <TextBlock x:Name="txtTotalBelopp"
                           Text="0 kr"
                           FontSize="22"
                           FontWeight="Bold"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button Content="Avbryt"
                        Width="120"
                        Margin="5"/>

                <Button Content="Skapa bokning"
                        Width="150"
                        Margin="5"
                        Click="SkapaBokning_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>