<Window x:Class="Presentationslager.Bokning"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skapa bokning"
        Height="800"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource IsBlå}"
          Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- RUBRIK -->

        <TextBlock Grid.Row="0"
                   Text="Skapa bokning"
                   Style="{StaticResource HeaderTextStyle}"
                   Margin="0,0,0,20"/>


        <!-- KUND OCH DATUM -->

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="250"/>

                <ColumnDefinition Width="40"/>

                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>

                <ColumnDefinition Width="20"/>

                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>

            </Grid.ColumnDefinitions>


            <TextBlock Text="Kund:"
                       VerticalAlignment="Center"
                       Margin="5"/>


            <ComboBox Grid.Column="1"
                      Height="30"
                      Margin="5"
                      ItemsSource="{Binding Kunder}"
                      SelectedItem="{Binding ValdKund, Mode=TwoWay}"
                      DisplayMemberPath="DisplayText"/>


            <TextBlock Grid.Column="3"
                       Text="Från:"
                       VerticalAlignment="Center"
                       Margin="5"/>


            <DatePicker Grid.Column="4"
                        Height="30"
                        Margin="5"
                        SelectedDate="{Binding StartDatum, Mode=TwoWay}"/>


            <TextBlock Grid.Column="6"
                       Text="Till:"
                       VerticalAlignment="Center"
                       Margin="5"/>


            <DatePicker Grid.Column="7"
                        Height="30"
                        Margin="5"
                        SelectedDate="{Binding SlutDatum, Mode=TwoWay}"/>

        </Grid>


        <!-- ALLA BOKNINGSDELAR -->

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>


                <!-- ===================================== -->
                <!-- BOENDE                                -->
                <!-- ===================================== -->

                <Border Background="White"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,15">

                    <StackPanel>


                        <TextBlock Text="Boende"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>


                        <!-- VALDA BOENDEN -->

                        <ItemsControl ItemsSource="{Binding LogiRader}"
                                      Margin="0,0,0,10">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border BorderBrush="LightGray"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10"
                                            Margin="0,0,0,5">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>


                                            <StackPanel>

                                                <TextBlock Text="{Binding LogiDisplayText}"
                                                           FontWeight="Bold"/>


                                                <TextBlock>

                                                    <Run Text="Antal personer: "/>

                                                    <Run Text="{Binding AntalPersoner}"/>

                                                </TextBlock>


                                                <TextBlock>

                                                    <Run Text="Period: "/>

                                                    <Run Text="{Binding StartDatum,
                                                        StringFormat={}{0:yyyy-MM-dd}}"/>

                                                    <Run Text=" - "/>

                                                    <Run Text="{Binding SlutDatum,
                                                        StringFormat={}{0:yyyy-MM-dd}}"/>

                                                </TextBlock>

                                            </StackPanel>


                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LogiBelopp,
                                                       StringFormat={}{0:N0} kr}"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="20,0,0,0"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>


                        <!-- LÄGG TILL BOENDE -->

                        <Expander Header="+ Lägg till boende">

                            <StackPanel Margin="10">


                                <TextBlock Text="Antal personer:"/>


                                <ComboBox Height="30"
                                          Margin="0,5,0,10"
                                          ItemsSource="{Binding AntalPersonerAlternativ}"
                                          SelectedItem="{Binding AntalPersonerTotalt,
                                          Mode=TwoWay}"/>


                                <TextBlock Text="{Binding BoendePlaceringText}"
                                           Margin="0,0,0,10"
                                           FontWeight="SemiBold"/>


                                <TextBlock Text="Boendetyp:"/>


                                <ComboBox Height="30"
                                          Margin="0,5,0,10"
                                          ItemsSource="{Binding BoendeTyper}"
                                          SelectedItem="{Binding ValdBoendeTyp,
                                          Mode=TwoWay}"/>


                                <TextBlock Text="Boende:"/>


                                <ComboBox Height="30"
                                          Margin="0,5,0,10"
                                          ItemsSource="{Binding TillgängligaLogi}"
                                          SelectedItem="{Binding ValtLogi, Mode=TwoWay}"
                                          DisplayMemberPath="TypDisplayText" 
                                          IsEnabled="{Binding FinnsTillgängligaLogi}" />

                                <TextBlock Text="Inga boenden är tillgängliga för vald period."
                                           Foreground="DarkRed"
                                           FontStyle="Italic"
                                           Margin="0,0,0,10">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VisaIngaTillgängligaLogi}"
                                                                Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>



                                <TextBlock Text="Antal personer i detta boende:"/>


                                <ComboBox Height="30"
                                          Margin="0,5,0,10"
                                          ItemsSource="{Binding AntalPersonerValtLogiAlternativ}"
                                          SelectedItem="{Binding AntalPersonerValtLogi,
                                          Mode=TwoWay}"/>


                                <TextBlock Text="Pris:"
                                           Margin="0,0,0,5"/>


                                <TextBlock Text="{Binding LogiPrisText}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>


                                <Button Content="Lägg till"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        Command="{Binding LäggTillLogiCommand}"/>

                            </StackPanel>

                        </Expander>

                    </StackPanel>

                </Border>


                <!-- ===================================== -->
                <!-- UTRUSTNING                            -->
                <!-- ===================================== -->

                <!-- UTRUSTNING -->
                <Border Background="White"
        CornerRadius="5"
        Padding="15"
        Margin="0,0,0,15">

                    <Border.Resources>
                        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
                    </Border.Resources>

                    <StackPanel>

                        <TextBlock Text="Utrustning"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

                        <!-- Vald utrustning -->
                        <ItemsControl ItemsSource="{Binding UtrustningRader}"
                      Margin="0,0,0,10">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border BorderBrush="LightGray"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,0,0,5">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>

                                                <TextBlock Text="{Binding UtrustningDisplayText}"
                                           FontWeight="Bold"/>

                                                <TextBlock>
                                    <Run Text="Period: "/>
                                    <Run Text="{Binding StartDatum, StringFormat={}{0:yyyy-MM-dd}}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding SlutDatum, StringFormat={}{0:yyyy-MM-dd}}"/>
                                                </TextBlock>

                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                       Text="{Binding UtrustningBelopp, StringFormat={}{0:N0} kr}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="20,0,0,0"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>


                        <Expander Header="+ Lägg till utrustning">

                            <StackPanel Margin="10">

                                <TextBlock Text="Boka som:"/>

                                <ComboBox Height="30"
                          Margin="0,5,0,10"
                          ItemsSource="{Binding UtrustningTyper}"
                          SelectedItem="{Binding ValdUtrustningTyp, Mode=TwoWay}"/>


                                <!-- Utrustningspaket -->
                                <StackPanel Visibility="{Binding VisarUtrustningsPaket,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <TextBlock Text="Utrustningspaket:"/>

                                    <ComboBox Height="30"
                              Margin="0,5,0,10"
                              ItemsSource="{Binding TillgängligaUtrustningsPaket}"
                              SelectedItem="{Binding ValtUtrustningPaket, Mode=TwoWay}"
                              DisplayMemberPath="UtrustningPaketNamn"/>

                                    <TextBlock Text="Antal paket:"/>

                                    <ComboBox Height="30"
                              Margin="0,5,0,10"
                              ItemsSource="{Binding AntalUtrustningsPaketAlternativ}"
                              SelectedItem="{Binding AntalUtrustningsPaket, Mode=TwoWay}"/>

                                </StackPanel>


                                <!-- Enskild utrustning -->
                                <StackPanel Visibility="{Binding VisarEnskildUtrustning,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <TextBlock Text="Enskild utrustning:"/>

                                    <ComboBox Height="30"
                                              Margin="0,5,0,10"
                                              ItemsSource="{Binding TillgängligaUtrustningArtikelTyper}"
                                              SelectedItem="{Binding ValdUtrustningArtikelTyp, Mode=TwoWay}"
                                              DisplayMemberPath="TypNamn"/>

                                </StackPanel>


                                <TextBlock Text="Pris:"
                           Margin="0,0,0,5"/>

                                <TextBlock Text="{Binding UtrustningPrisText}"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                                <Button Content="Lägg till"
                        Width="120"
                        HorizontalAlignment="Left"
                        Command="{Binding LäggTillUtrustningCommand}"/>

                            </StackPanel>

                        </Expander>

                    </StackPanel>

                </Border>


                <!-- ===================================== -->
                <!-- KONFERENS                             -->
                <!-- ===================================== -->

                <Border Background="White"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,15">

                    <StackPanel>


                        <TextBlock Text="Konferens"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>


                        <TextBlock Text="Ingen konferens vald ännu."
                                   FontStyle="Italic"
                                   Margin="0,0,0,10"/>


                        <Expander Header="+ Lägg till konferens">

                            <StackPanel Margin="10">


                                <TextBlock Text="Konferenslokal:"/>


                                <ComboBox Height="30"
                                          Margin="0,5,0,10"/>


                                <TextBlock Text="Antal personer:"/>


                                <TextBox Height="30"
                                         Margin="0,5,0,10"/>


                                <TextBlock Text="Starttid:"/>


                                <DatePicker Height="30"
                                            Margin="0,5,0,10"/>


                                <TextBlock Text="Sluttid:"/>


                                <DatePicker Height="30"
                                            Margin="0,5,0,10"/>


                                <TextBlock Text="Pris:"
                                           Margin="0,0,0,5"/>


                                <TextBlock Text="0 kr"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>


                                <Button Content="Lägg till"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        IsEnabled="False"/>

                            </StackPanel>

                        </Expander>

                    </StackPanel>

                </Border>


                <!-- ===================================== -->
                <!-- SKIDLEKTION                           -->
                <!-- ===================================== -->

                <Border Background="White"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,15">

                    <StackPanel>


                        <TextBlock Text="Skidlektion"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>


                        <TextBlock Text="Ingen skidlektion vald ännu."
                                   FontStyle="Italic"
                                   Margin="0,0,0,10"/>


                        <Expander Header="+ Lägg till skidlektion">

                            <StackPanel Margin="10">


                                <TextBlock Text="Skidlektion:"/>


                                <ComboBox Height="30"
                                          Margin="0,5,0,10"/>


                                <TextBlock Text="Antal personer:"/>


                                <TextBox Height="30"
                                         Margin="0,5,0,10"/>


                                <TextBlock Text="Datum:"/>


                                <DatePicker Height="30"
                                            Margin="0,5,0,10"/>


                                <TextBlock Text="Pris:"
                                           Margin="0,0,0,5"/>


                                <TextBlock Text="0 kr"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>


                                <Button Content="Lägg till"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        IsEnabled="False"/>

                            </StackPanel>

                        </Expander>

                    </StackPanel>

                </Border>


            </StackPanel>

        </ScrollViewer>


        <!-- ===================================== -->
        <!-- TOTAL OCH KNAPPAR                     -->
        <!-- ===================================== -->

        <Grid Grid.Row="3"
              Margin="0,20,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">


                <TextBlock Text="Totalt:"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,10,0"/>


                <TextBlock Text="{Binding TotalBeloppText}"
                           FontSize="22"
                           FontWeight="Bold"/>

            </StackPanel>


            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">


                <Button Content="Avbryt"
                        Width="120"
                        Margin="5"
                        Command="{Binding AvbrytCommand}"/>


                <Button Content="Skapa bokning"
                        Width="150"
                        Margin="5"
                        Command="{Binding SkapaBokningCommand}"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>