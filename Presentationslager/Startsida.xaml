<Window x:Class="Presentationslager.Startsida"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:Presentationslager.ViewModel"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager"
        mc:Ignorable="d" FontFamily="OpenSans-Medium"
        Title="Ski-Center Startsida" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">



    <!-- Huvudbakgrund, en neutral ljus färg hjälper inloggningskortet att poppa fram -->
    <Grid Background="#F4F6F9">

        <!-- Inloggningskortet med IsBlå bakgrund -->
        <Border Background="{StaticResource IsBlå}" 
                Margin="40" 
                CornerRadius="15" 
                Padding="40" 
                MaxWidth="450" 
                VerticalAlignment="Center">

            <!-- Lägger till en snygg skugga bakom kortet -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="Black"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">

                <!-- Logotyp -->
                <Image Source="Logotyp Ski-center.png" 
                       Height="90" 
                       Margin="0,0,0,5" 
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Slogan -->
                <TextBlock Text="“Mer än bara skidåkning.”" 
                           FontSize="15" 
                           FontStyle="Italic" 
                           FontWeight="Medium"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,25" />

                <!-- Rubrik för formuläret -->
                <TextBlock Text="Personalportal - Inloggning" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,25" />

                <!-- E-post -->
                <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmailInlogg" 
                         Height="40" 
                         Padding="10,0" 
                         Margin="0,0,0,15" 
                         FontSize="14" 
                         VerticalContentAlignment="Center" 
                         BorderThickness="0"/>

                <!-- Lösenord -->
                <TextBlock Text="Lösenord" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtLösenord" 
                             Height="40" 
                             Padding="10,0" 
                             Margin="0,0,0,30" 
                             FontSize="14" 
                             VerticalContentAlignment="Center" 
                             BorderThickness="0"/>

                <!-- Inloggningsknapp -->
                <Button Content="Logga in" 
                        FontWeight="Bold" 
                        FontSize="15"
                        Command="{Binding OpenMenuCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        HorizontalAlignment="Stretch" 
                        Height="45" 
                        Cursor="Hand">
                    <!-- Gör knappen lite mjukare i kanterna (kräver att standardmallen tillåter det, annars ignoreras det) -->
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>