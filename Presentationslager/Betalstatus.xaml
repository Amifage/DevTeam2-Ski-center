<Window x:Class="Presentationslager.Betalstatus"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager"
        mc:Ignorable="d"
        Title="Betalstatus" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource IsBlå}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
           Text="Fakturor" 
           Style="{StaticResource HeaderTextStyle}"
           Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="{StaticResource Snövit}" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="FakturaNummer:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SokFakturaNummer, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="30" Padding="5,3,5,3" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="Satus:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Status}" SelectedItem="{Binding ValdStatus}" Width="150" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button Content="Sök" Command="{Binding SokCommand}" Width="90" Height="30" Margin="0,0,10,0"/>
                    <Button Content="Rensa" Command="{Binding RensaCommand}" Width="90" Height="30"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <DataGrid ItemsSource="{Binding FakturaLista}" 
              SelectedItem="{Binding ValdFaktura}"
              AutoGenerateColumns="False" 
              IsReadOnly="True"
              Background="{StaticResource Snövit}"
              RowBackground="{StaticResource Snövit}"
              AlternatingRowBackground="#F9F9F9"
              Foreground="Black"
              GridLinesVisibility="Horizontal"
              HorizontalGridLinesBrush="#E0E0E0"
              CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FakturaNr" Binding="{Binding FakturaNummer}" Width="80"/>
                    <DataGridTextColumn Header="Kundnamn" Binding="{Binding bokning.kund.VisningsNamn}" Width="150"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="Fakturatyp" Binding="{Binding FakturaTyp}" Width="90"/>
                    <DataGridTextColumn Header="Anteckning" Binding="{Binding Anteckning}" Width="*"/>
                    <DataGridTextColumn Header="Faktutadatum" Binding="{Binding Fakturadatum, StringFormat=\{0:yyyy-MM-dd\}}" Width="110"/>
                    <DataGridTextColumn Header="Förfallodatum" Binding="{Binding Förfallodatum, StringFormat=\{0:yyyy-MM-dd\}}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Uppdatera status" Command="{Binding UppdateraStatusCommand}" Width="150" Height="35" Margin="0,0,10,0"/>
            <Button Content="Tillbaka" 
            Command="{Binding TillbakaCommand}" 
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
            Width="150" Height="35"/>
        </StackPanel>

    </Grid>
</Window>
