<Window x:Class="Presentationslager.Skidlektion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Skidlektion" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource IsBlå}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Kommande skidlektioner"
                   Style="{StaticResource HeaderTextStyle}"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="{StaticResource Snövit}" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="Datum (ÅÅÅÅ-MM-DD):" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SokDatum, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Utan datum visas kommande två veckor. Skriv ett helt datum för att se lektioner längre fram."
                             Width="140" Height="30" Padding="5,3,5,3" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="Status:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SokStatus, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="30" Padding="5,3,5,3" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="Artikeltyp:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding ArtikelTyper}" SelectedItem="{Binding ValdArtikelTyp}" Width="150" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="Instruktör:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Instruktorer}" SelectedItem="{Binding ValdInstruktor}" Width="200" Height="30" VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AnställningsNummer}"/>
                                    <TextBlock Text=" – "/>
                                    <TextBlock Text="{Binding Förnamn}"/>
                                    <TextBlock Text=" "/>
                                    <TextBlock Text="{Binding Efternamn}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button Content="Sök" Command="{Binding SokCommand}" Width="90" Height="30" Margin="0,0,10,0"/>
                    <Button Content="Rensa" Command="{Binding RensaCommand}" Width="90" Height="30"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <DataGrid ItemsSource="{Binding SkidlektionsLista}"
                      SelectedItem="{Binding ValdSkidlektion}"
                      SelectionMode="Single"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="{StaticResource Snövit}"
                      RowBackground="White"
                      AlternatingRowBackground="#F9F9F9"
                      Foreground="Black"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E0E0E0"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lektions-ID" Binding="{Binding SkidlektionNummer}" Width="90"/>
                    <DataGridTextColumn Header="Typ / Nivå" Binding="{Binding artikelTyp.TypNamn}" Width="140"/>
                    <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=\{0:yyyy-MM-dd\}}" Width="100"/>
                    <DataGridTextColumn Header="Start" Binding="{Binding StartTid, StringFormat=\{0:hh\\:mm\}}" Width="70"/>
                    <DataGridTextColumn Header="Slut" Binding="{Binding SlutTid, StringFormat=\{0:hh\\:mm\}}" Width="70"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Kapacitet" Binding="{Binding Kapacitet}" Width="80"/>
                    <DataGridTextColumn Header="Anst.nr" Binding="{Binding Personal.AnställningsNummer}" Width="80"/>
                    <DataGridTextColumn Header="Instruktör" Binding="{Binding Personal.Förnamn}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="Ny instruktör:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox ItemsSource="{Binding AllaAnstallda}" SelectedItem="{Binding NyInstruktor}"
                      Width="220" Height="35" VerticalContentAlignment="Center" Margin="0,0,10,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AnställningsNummer}"/>
                            <TextBlock Text=" – "/>
                            <TextBlock Text="{Binding Förnamn}"/>
                            <TextBlock Text=" "/>
                            <TextBlock Text="{Binding Efternamn}"/>
                            <TextBlock Text=" ("/>
                            <TextBlock Text="{Binding Roll}"/>
                            <TextBlock Text=")"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Uppdatera instruktör" Command="{Binding UppdateraInstruktorCommand}" Width="150" Height="35" Margin="0,0,10,0"/>
            <Button Content="Tillbaka"
                    Command="{Binding TillbakaCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Width="150" Height="35"/>
        </StackPanel>
    </Grid>
</Window>