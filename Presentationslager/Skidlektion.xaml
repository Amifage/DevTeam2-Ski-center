<Window x:Class="Presentationslager.Skidlektion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="skidlektionFönster"
        Title="Skidlektion" Height="500" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Använder HeaderTextStyle från App.xaml för rubriken -->
        <TextBlock Grid.Row="0" Text="Kommande skidlektioner" 
                   Style="{StaticResource HeaderTextStyle}" 
                   Margin="0,0,0,15"/>

        <!-- Filter-kort med rundade hörn och IsBlå ram/bakgrund -->
        <Border Grid.Row="1" Background="{StaticResource IsBlå}" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Anställd / instruktör:" FontSize="12" Foreground="{StaticResource Midnattsgrå}" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Instruktörer}"
                              SelectedItem="{Binding ValdInstruktör}"
                              Width="220" Height="32" VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AnställningsNummer}"/>
                                    <TextBlock Text=" – "/>
                                    <TextBlock Text="{Binding Förnamn}"/>
                                    <TextBlock Text=" "/>
                                    <TextBlock Text="{Binding Efternamn}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Sök (datum, typ, status):" FontSize="12" Foreground="{StaticResource Midnattsgrå}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Söktext, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Skriv ett helt datum, t.ex. 2026-12-15, för att se lektioner längre fram än två veckor"
                             Width="200" Height="32" VerticalContentAlignment="Center" Padding="5,0"/>
                </StackPanel>

                <!-- Använder den globala rundade knappstilen med sekundär färg (FjällBlå) -->
                <Button Content="Rensa filter" Command="{Binding RensaFilterCommand}"
                        Width="120" Height="32" VerticalAlignment="Bottom"
                        />

                <TextBlock Text="{Binding InfoText}" VerticalAlignment="Bottom"
                           Margin="20,0,0,8" Foreground="{StaticResource Midnattsgrå}"/>
            </StackPanel>
        </Border>

        <!-- DataGrid anpassat efter profilen -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding VisadeLektioner}" AutoGenerateColumns="False"
                  IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  Background="{StaticResource Snövit}" HorizontalGridLinesBrush="{StaticResource IsBlå}" RowHeight="35">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Lektions-ID" Binding="{Binding SkidlektionNummer}" Width="90"/>
                <DataGridTextColumn Header="Typ / Nivå" Binding="{Binding artikelTyp.TypNamn}" Width="140"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                <DataGridTextColumn Header="Start" Binding="{Binding StartTid, StringFormat={}{0:hh\:mm}}" Width="70"/>
                <DataGridTextColumn Header="Slut" Binding="{Binding SlutTid, StringFormat={}{0:hh\:mm}}" Width="70"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Kapacitet" Binding="{Binding Kapacitet}" Width="80"/>
                <DataGridTextColumn Header="Anst.nr" Binding="{Binding Personal.AnställningsNummer}" Width="80"/>
                <DataGridTextColumn Header="Instruktör" Binding="{Binding Personal.Förnamn}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Stäng-knapp (använder global knappstil med SolnedgångOrange eller FjällBlå) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Stäng" Command="{Binding StängCommand}"
                    CommandParameter="{Binding ElementName=skidlektionFönster}"
                    Width="100" Height="35"/>
        </StackPanel>
    </Grid>
</Window>