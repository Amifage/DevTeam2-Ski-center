<Window x:Class="Presentationslager.Utrustning"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager"
        xmlns:vm="clr-namespace:Presentationslager.ViewModel"
        mc:Ignorable="d"
        Title="Utrustning" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:UtrustningViewModel />
    </Window.DataContext>

    <Grid Background="{StaticResource IsBlå}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Rubrik -->
        <TextBlock Grid.Row="0"
                   Text="Utrustning" 
                   Style="{StaticResource HeaderTextStyle}"
                   Margin="0,0,0,20"/>

        <!-- Sök- och filtreringssektion i vitt kort -->
        <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="Utrustningsnummer:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SokUtrustningNummer, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="30" Padding="5,3,5,3" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="Status:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SokStatus, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="30" Padding="5,3,5,3" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="Artikeltyp:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding ArtikelTyper}" SelectedItem="{Binding ValdArtikelTyp}" Width="150" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="Utrustningspaket:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding UtrustningsPaketLista}" SelectedItem="{Binding ValdtUtrustningsPaket}" Width="150" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button Content="Sök" Command="{Binding SokCommand}" Width="90" Height="30" Margin="0,0,10,0"/>
                    <Button Content="Rensa" Command="{Binding RensaCommand}" Width="90" Height="30"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Tabell för utrustning i vitt kort -->
        <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <DataGrid ItemsSource="{Binding UtrustningsLista}" 
                      SelectedItem="{Binding ValdUtrustning}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F9F9F9"
                      Foreground="Black"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E0E0E0"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Utrustningsnummer" Binding="{Binding UtrustningNummer}" Width="160"/>
                    <DataGridTextColumn Header="Artikeltyp" Binding="{Binding artikelTyp.TypNamn}" Width="200"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180"/>
                    <DataGridTextColumn Header="Senast Uppdaterad" Binding="{Binding SenastUppdaterad, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Åtgärdsknappar längst ner -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Uppdatera status" Command="{Binding UppdateraStatusCommand}" Width="150" Height="35"/>
        </StackPanel>
    </Grid>
</Window>