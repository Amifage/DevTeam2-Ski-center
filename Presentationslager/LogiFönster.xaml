<Window x:Class="Presentationslager.LogiFönster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager" xmlns:viewmodel="clr-namespace:Presentationslager.ViewModel"
        mc:Ignorable="d"
        Title="Logi" Height="700" Width="1000"
 WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource IsBlå}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
               Text="Logi" 
               Style="{StaticResource HeaderTextStyle}"
               Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="{StaticResource Snövit}" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="LogiNummer:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SokLogiNummer, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="30" Padding="5,3,5,3" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="Status:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding StatusAlternativ}"
                      SelectedItem="{Binding SokStatus, UpdateSourceTrigger=PropertyChanged}"                    
                       Width="140" Height="30" Padding="5,3,5,3" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="Logityp:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding ArtikelTyper}" SelectedItem="{Binding ValdArtikelTyp}" Width="150" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button Content="Sök" Command="{Binding SokCommand}" Width="90" Height="30" Margin="0,0,10,0"/>
                    <Button Content="Rensa" Command="{Binding RensaCommand}" Width="90" Height="30"/>
                </StackPanel>
                <Grid Height="90" Width="120" Margin="25,-25,0,0" VerticalAlignment="Bottom">
                    <Image Source="Logi-ikon.png" 
                            Stretch="Uniform"/>
                </Grid>


            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Snövit}" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <DataGrid ItemsSource="{Binding LogiLista}" 
                  SelectedItem="{Binding ValdLogi}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  Background="{StaticResource Snövit}"
                  RowBackground="White"
                  AlternatingRowBackground="#F9F9F9"
                  Foreground="Black"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E0E0E0"
                  CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Logiummer" Binding="{Binding LogiNummer}" Width="100"/>
                    <DataGridTextColumn Header="Kapacitet" Binding="{Binding LogiKapacitet}" Width="150"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>
                    <DataGridTextColumn Header="Faciliteter" Binding="{Binding Faciliteter}" Width="130"/>
                    <DataGridTextColumn Header="Antal rum" Binding="{Binding AntalRum}" Width="110"/>
                    <DataGridTextColumn Header="Senast Uppdaterad" Binding="{Binding SenastUppdaterad, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Uppdatera status" Command="{Binding UppdateraStatusCommand}" Width="150" Height="35" Margin="0,0,10,0"/>
            <Button Content="Tillbaka" 
                Command="{Binding TillbakaCommand}" 
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                Width="150" Height="35"/>
        </StackPanel>

    </Grid>
</Window>
