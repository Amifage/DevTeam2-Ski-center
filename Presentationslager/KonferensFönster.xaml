<Window x:Class="Presentationslager.KonferensFönster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager"
        xmlns:vm="clr-namespace:Presentationslager.ViewModel"
        mc:Ignorable="d"
        Title="Konferensrum" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">


    <Grid Background="{StaticResource IsBlå}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Konferensrum" 
                   Style="{StaticResource HeaderTextStyle}"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="{StaticResource Snövit}" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="Rumsnummer:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SokRumsNummer, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="30" Padding="5,3,5,3" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="Status:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding StatusAlternativ}"
                     SelectedItem="{Binding SokStatus, UpdateSourceTrigger=PropertyChanged}"                    
                      Width="140" Height="30" Padding="5,3,5,3" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,15,10">
                    <TextBlock Text="Rumstyp / Storlek:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding RumsTyper}" SelectedItem="{Binding ValdRumsTyp}" Width="160" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button Content="Sök" Command="{Binding SokCommand}" Width="90" Height="30" Margin="0,0,10,0"/>
                    <Button Content="Rensa" Command="{Binding RensaCommand}" Width="90" Height="30"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <DataGrid ItemsSource="{Binding KonferensLista}" 
                      SelectedItem="{Binding ValdKonferensrum}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      Background="{StaticResource Snövit}"
                      RowBackground="White"
                      AlternatingRowBackground="#F9F9F9"
                      Foreground="Black"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E0E0E0"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Rumsnummer" Binding="{Binding KonferensNummer}" Width="140"/>
                    <DataGridTextColumn Header="Kapacitet" Binding="{Binding KonferensKapacitet}" Width="130"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                    <DataGridTextColumn Header="Senast Uppdaterad" Binding="{Binding SenastUppdaterad, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Uppdatera status" Command="{Binding UppdateraStatusCommand}" Width="140" Height="35" Margin="0,0,10,0"/>
            <Button Content="Tillbaka" 
                    Command="{Binding TillbakaCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                    Width="130" Height="35"/>
        </StackPanel>

    </Grid>
</Window>