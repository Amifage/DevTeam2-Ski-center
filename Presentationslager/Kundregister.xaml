<Window x:Class="Presentationslager.Kundregister"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kundregister" Height="750" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15" Background="{StaticResource IsBlå}">
        <Grid.ColumnDefinitions>
            <!-- Vänster sida: Kundlistan -->
            <ColumnDefinition Width="6*" />
            <!-- Mitten: Avstånd -->
            <ColumnDefinition Width="20" />
            <!-- Höger sida: Formuläret -->
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <!-- VÄNSTER: LISTAN -->
        <DataGrid Grid.Column="0" 
                  ItemsSource="{Binding Kunder}" 
                  SelectedItem="{Binding ValdKund}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  HeadersVisibility="Column"
                  Background="{StaticResource Snövit}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kund-ID" Binding="{Binding KundNummer}" Width="80"/>
                <DataGridTextColumn Header="E-post" Binding="{Binding Epost}" Width="*"/>
                <DataGridTextColumn Header="Telefon" Binding="{Binding Telefonnummer}" Width="120"/>
                <DataGridTextColumn Header="Ort" Binding="{Binding Ort}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- HÖGER: FORMULÄRET -->
        <Border Grid.Column="2" Background="{StaticResource Snövit}" CornerRadius="5" Padding="15">
            <Grid>
                <!-- Definiera rader i högra kolumnen. Rad 0 tar allt utrymme den kan, Rad 1 tar bara den plats som behövs för bottenknappen. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Kunduppgifter" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15" />

                        <!-- Välj Kundtyp -->
                        <TextBlock Text="Välj kundtyp:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox SelectedIndex="{Binding ValdKundTypIndex}" Margin="0,0,0,15" Padding="5">
                            <ComboBoxItem Content="Privatkund" />
                            <ComboBoxItem Content="Företagskund" />
                        </ComboBox>

                        <!-- GEMENSAMMA FÄLT -->
                        <TextBlock Text="E-post" Foreground="Gray"/>
                        <TextBox Text="{Binding NyEpost}" Margin="0,0,0,10" Padding="5"/>

                        <TextBlock Text="Telefonnummer" Foreground="Gray"/>
                        <TextBox Text="{Binding NyTelefon}" Margin="0,0,0,10" Padding="5"/>

                        <TextBlock Text="Adress" Foreground="Gray"/>
                        <TextBox Text="{Binding NyAdress}" Margin="0,0,0,10" Padding="5"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Postnummer" Foreground="Gray"/>
                                <TextBox Text="{Binding NyPostnummer}" Padding="5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ort" Foreground="Gray"/>
                                <TextBox Text="{Binding NyOrt}" Padding="5"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rabatt (%)" Foreground="Gray"/>
                                <TextBox Text="{Binding NyRabatt}" Padding="5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Kredit" Foreground="Gray"/>
                                <TextBox Text="{Binding NyKredit}" Padding="5"/>
                            </StackPanel>
                        </Grid>

                        <!-- PRIVATKUND-SPECIFIKA FÄLT (Index 0) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ValdKundTypIndex}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Förnamn" Foreground="Gray"/>
                            <TextBox Text="{Binding NyttFörnamn}" Margin="0,0,0,10" Padding="5"/>

                            <TextBlock Text="Efternamn" Foreground="Gray"/>
                            <TextBox Text="{Binding NyttEfternamn}" Margin="0,0,0,10" Padding="5"/>
                        </StackPanel>

                        <!-- FÖRETAGSKUND-SPECIFIKA FÄLT (Index 1) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ValdKundTypIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Företagsnamn" Foreground="Gray"/>
                            <TextBox Text="{Binding NyttFöretagsnamn}" Margin="0,0,0,10" Padding="5"/>
                        </StackPanel>

                        <!-- Spara/Rensa Knappar (direkt under formuläret) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="Rensa" Command="{Binding RensaFormularCommand}" Width="80" Margin="0,0,10,0" Background="LightGray" Foreground="Black" BorderThickness="0" Padding="5"/>
                            <Button Content="Spara Kund" Command="{Binding SparaKundCommand}" Width="120" Background="{StaticResource SolnedgångOrange}" Foreground="White" BorderThickness="0" Padding="5"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="1" 
                        Content="Tillbaka till Meny" 
                        Command="{Binding TillbakaCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        HorizontalAlignment="Right" 
                        Margin="0,15,0,0" 
                        Width="120" 
                        Background="Transparent" 
                        Foreground="Gray" 
                        BorderBrush="Gray" 
                        BorderThickness="1" 
                        Padding="5"/>
            </Grid>
        </Border>
    </Grid>
</Window>