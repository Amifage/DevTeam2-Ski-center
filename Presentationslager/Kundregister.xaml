<Window x:Class="Presentationslager.Kundregister"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kundregister" Height="750" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15" Background="{StaticResource IsBlå}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Sök:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold" Foreground="#333"/>
                <TextBox Text="{Binding SökText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="130" Padding="5" Margin="0,0,2,0" />

                <Button Content="✕" Command="{Binding RensaSokningCommand}" ToolTip="Rensa sökfältet" Width="25" Height="26" Margin="0,0,15,0" Background="{StaticResource Snövit}" BorderThickness="0" Cursor="Hand" />

                <TextBlock Text="Visa:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold" Foreground="#333"/>
                <ComboBox SelectedIndex="{Binding ValdFilterTypIndex}" Width="140" Padding="5" Margin="0,0,15,0">
                    <ComboBoxItem Content="Alla kunder" />
                    <ComboBoxItem Content="Endast Privatkunder" />
                    <ComboBoxItem Content="Endast Företagskunder" />
                </ComboBox>

            </StackPanel>

            <DataGrid Grid.Row="1" 
                      ItemsSource="{Binding FiltreradeKunder}" 
                      SelectedItem="{Binding ValdKund}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="1"
                      HeadersVisibility="Column"
                      Background="{StaticResource Snövit}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kund-nr" Binding="{Binding KundNummer}" Width="75"/>
                    <DataGridTextColumn Header="Namn" Binding="{Binding VisningsNamn}" Width="140"/>
                    <DataGridTextColumn Header="Ort" Binding="{Binding Ort}" Width="100"/>
                    <DataGridTextColumn Header="E-post" Binding="{Binding Epost}" Width="*"/>
                    <DataGridTextColumn Header="Telefon" Binding="{Binding Telefonnummer}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>


        <Border Grid.Column="2" Background="{StaticResource Snövit}" CornerRadius="5" Padding="15">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Kunduppgifter"  Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,15" />

                        <Grid Height="80" Width="100" Margin="150,-65,0,0" VerticalAlignment="Bottom">
                            <Image Source="Kundregister-ikon.png" 
                                Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>

                        <TextBlock Text="Välj kundtyp:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox SelectedIndex="{Binding ValdKundTypIndex}" Margin="0,0,0,15" Padding="5">
                            <ComboBoxItem Content="Privatkund" />
                            <ComboBoxItem Content="Företagskund" />
                        </ComboBox>

                        <TextBlock Text="E-post" Foreground="Gray"/>
                        <TextBox Text="{Binding NyEpost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                        <TextBlock Text="Telefonnummer" Foreground="Gray"/>
                        <TextBox Text="{Binding NyTelefon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="EndastSiffror_PreviewTextInput" Margin="0,0,0,10" Padding="5"/>

                        <TextBlock Text="Adress" Foreground="Gray"/>
                        <TextBox Text="{Binding NyAdress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Postnummer" Foreground="Gray"/>
                                <TextBox Text="{Binding NyPostnummer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="EndastSiffror_PreviewTextInput" Padding="5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ort" Foreground="Gray"/>
                                <TextBox Text="{Binding NyOrt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rabatt (%)" Foreground="Gray"/>
                                <TextBox Text="{Binding NyRabatt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="5" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Kredit" Foreground="Gray"/>
                                <TextBox Text="{Binding NyKredit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:#,0}}" Padding="5">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="IsReadOnly" Value="False"/>
                                            <Setter Property="Background" Value="White"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ValdKundTypIndex}" Value="0">
                                                    <Setter Property="IsReadOnly" Value="True"/>
                                                    <Setter Property="Background" Value="#EEEEEE"/>
                                                    <Setter Property="Foreground" Value="DimGray"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ValdKundTypIndex}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Förnamn" Foreground="Gray"/>
                            <TextBox Text="{Binding NyttFörnamn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                            <TextBlock Text="Efternamn" Foreground="Gray"/>
                            <TextBox Text="{Binding NyttEfternamn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ValdKundTypIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Företagsnamn" Foreground="Gray"/>
                            <TextBox Text="{Binding NyttFöretagsnamn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">

                            <Button Content="Ta bort" Command="{Binding TaBortKundCommand}" Width="70" Margin="0,0,10,0" Background="#FFD66570"  Padding="5"/>
                            
                            <Button Content="Rensa" Command="{Binding RensaFormularCommand}" Width="70" Margin="0,0,10,0" Padding="5"/>

                            <Button Content="Spara Ny" Command="{Binding SparaKundCommand}" Width="70" Margin="0,0,10,0" Background="{StaticResource FjällBlå}"  Padding="5"/>

                            <Button Content="Uppdatera" Command="{Binding UppdateraKundCommand}" Width="70" Background="#FF68D068"  Padding="5"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="1" 
                        Content="Tillbaka" 
                        Command="{Binding TillbakaCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        HorizontalAlignment="Right" 
                        Margin="0,15,0,0" 
                        Width="120"                        
                        Padding="5"/>
            </Grid>
        </Border>
    </Grid>
</Window>