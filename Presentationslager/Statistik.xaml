<Window x:Class="Presentationslager.Statistik"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statistik" Height="800"
        Width="1300"
        MinWidth="1000" FontWeight="Bold"
        WindowStartupLocation="CenterScreen"
        Language="sv-SE">

    <Grid Margin="20" Background="{StaticResource IsBlå}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Statistik"
                   Style="{StaticResource HeaderTextStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>
        <Grid Height="80" Width="100" Margin="240,-10,0,0" VerticalAlignment="Bottom">
            <Image Source="Statistik-ikon.png"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <StackPanel Margin="10">
                <TextBlock Text="Startdatum"/>
                <DatePicker SelectedDate="{Binding StartDatum}" Width="150" Margin="0,5,0,0"/>
                <TextBlock Text="Jämför från" Foreground="Gray" Margin="0,10,0,0"/>
                <DatePicker SelectedDate="{Binding JämförStartDatum}" Width="150" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Margin="10">
                <TextBlock Text="Slutdatum"/>
                <DatePicker SelectedDate="{Binding SlutDatum}" Width="150" Margin="0,5,0,0"/>
                <TextBlock Text="Jämför till" Foreground="Gray" Margin="0,10,0,0"/>
                <DatePicker SelectedDate="{Binding JämförSlutDatum}" Width="150" Margin="0,5,0,0"/>
            </StackPanel>

            <Button Command="{Binding VisaStatistikCommand}"
                    Width="150" Height="40" Margin="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Visa statistik" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="3" Margin="0,10,0,0" HorizontalAlignment="Center">

            <StackPanel Margin="20,10">
                <TextBlock Text="📅 Bokningar" FontSize="16" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding Resultat.AntalBokningar, StringFormat='Antal: {0}'}"/>
                <TextBlock Text="{Binding Resultat.Föregående.AntalBokningar, StringFormat='Jämförelse: {0}'}" Foreground="Gray" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Resultat.Föregående.StartDatum, StringFormat='Från: {0:yyyy-MM-dd}'}" Foreground="Gray"/>
                <TextBlock Text="{Binding Resultat.Föregående.SlutDatum, StringFormat='Till: {0:yyyy-MM-dd}'}" Foreground="Gray"/>
            </StackPanel>

            <StackPanel Margin="20,10">
                <TextBlock Text="💰 Intäkter" FontSize="16" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding Resultat.IntäktLogi, StringFormat='Logi: {0:N0} kr'}"/>
                <TextBlock Text="{Binding Resultat.IntäktUtrustning, StringFormat='Utrustning: {0:N0} kr'}"/>
                <TextBlock Text="{Binding Resultat.IntäktSkidlektion, StringFormat='Skidlektion: {0:N0} kr'}"/>
                <TextBlock Text="{Binding Resultat.IntäktKonferens, StringFormat='Konferens: {0:N0} kr'}"/>
                <TextBlock Text="{Binding Resultat.TotalIntäkt, StringFormat='Totalt: {0:N0} kr'}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Resultat.Föregående.TotalIntäkt, StringFormat='Jämförelse: {0:N0} kr'}" Foreground="Gray"/>
            </StackPanel>

            <StackPanel Margin="20,10">
                <TextBlock Text="📈 Beläggning" FontSize="16" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding Resultat.BeläggningLogiProcent, StringFormat='Logi: {0} %'}"/>
                <TextBlock Text="{Binding Resultat.BeläggningUtrustningProcent, StringFormat='Utrustning: {0} %'}"/>
                <TextBlock Text="{Binding Resultat.BeläggningSkidlektionProcent, StringFormat='Skidlektioner: {0} %'}"/>
                <TextBlock Text="{Binding Resultat.AntalLektioner, StringFormat='Antal lektioner: {0}'}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Resultat.BokadeLektionsPlatser, StringFormat='Bokade platser: {0}'}"/>
                <TextBlock Text="Jämförelse:" Foreground="Gray" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Resultat.Föregående.BeläggningLogiProcent, StringFormat='Logi: {0} %'}" Foreground="Gray"/>
                <TextBlock Text="{Binding Resultat.Föregående.BeläggningUtrustningProcent, StringFormat='Utrustning: {0} %'}" Foreground="Gray"/>
                <TextBlock Text="{Binding Resultat.Föregående.BeläggningSkidlektionProcent, StringFormat='Skidlektioner: {0} %'}" Foreground="Gray"/>
            </StackPanel>
        </UniformGrid>

        <StackPanel Grid.Row="3" Margin="20,10,20,0">
            <TextBlock Text="🛏️ Logi per logialternativ" FontSize="16" Margin="0,0,0,10"/>
            <DataGrid ItemsSource="{Binding Resultat.LogiPerAlternativ}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      MaxHeight="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Logialternativ" Binding="{Binding Logialternativ}" Width="180"/>
                    <DataGridTextColumn Header="Antal enheter" Binding="{Binding AntalEnheter}" Width="180"/>
                    <DataGridTextColumn Header="Bokade nätter" Binding="{Binding BokadeNätter}" Width="180"/>
                    <DataGridTextColumn Header="Beläggning" Binding="{Binding BeläggningProcent, StringFormat='{}{0} %'}" Width="150"/>
                    <DataGridTextColumn Header="Intäkt" Binding="{Binding Intäkt, StringFormat='{}{0:N0} kr'}" Width="100"/>
                    <DataGridTextColumn Header="Beläggning jämförelse" Binding="{Binding FöregåendeBeläggningProcent, StringFormat='{}{0} %'}" Width="180"/>
                    <DataGridTextColumn Header="Intäkt jämförelse" Binding="{Binding FöregåendeIntäkt, StringFormat='{}{0:N0} kr'}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <Button Grid.Row="4"
                Command="{Binding TillbakaCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,10,0,0"
                Width="150" Height="50">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Tillbaka" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>